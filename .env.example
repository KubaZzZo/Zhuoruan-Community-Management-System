# 本地开发配置模板。复制为 .env 并填写数据库口令；不要提交 .env。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zhuoruan_recruitment
PORT=5173

# 留空时首次启动在 data/ 初始化随机工作人员账号。
# 可指定只含 username, role, name, department, salt, passwordHash 的账号 JSON 文件。
STAFF_ACCOUNTS_FILE=
SESSION_TTL_MINUTES=120
# 仅当 Node 只接受本机反向代理、且代理会覆盖 X-Forwarded-For 时设为 true。
# 直接对公网监听时必须保持 false，否则来源地址可被伪造并绕过限流。
TRUST_PROXY=false

# 修改这些配置后重启 Node/Vite 进程。
RECRUITMENT_ENABLED=true
# 同一学号可以在不同招新季再次报名。改季后重启服务，旧季记录只读。
RECRUITMENT_SEASON=2026
# 日期必须包含时区。留空代表不限制起止时间。
# 示例：2026-10-01T08:00:00+08:00
RECRUITMENT_OPENS_AT=
RECRUITMENT_CLOSES_AT=
# 这是人工清理的保留政策，系统不会自动删除资料。
RECRUITMENT_RETENTION_DAYS=180

# 每个出口 IP 在 报名（10 分钟）/进度查询（1 分钟）请求上限，适配校园网共用出口。
SUBMISSION_IP_LIMIT=600
LOOKUP_IP_LIMIT=1800
