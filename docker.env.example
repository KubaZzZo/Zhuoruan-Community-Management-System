# Copy to .env on the deployment server. Generate each password separately:
# openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
APP_DATABASE_PASSWORD=
APP_VERSION=local
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18185
# Only enable when the reverse proxy overwrites X-Forwarded-For and the app is private.
TRUST_PROXY=true
RECRUITMENT_SEASON=2026
RECRUITMENT_ENABLED=true
RECRUITMENT_OPENS_AT=
RECRUITMENT_CLOSES_AT=
RECRUITMENT_RETENTION_DAYS=180
